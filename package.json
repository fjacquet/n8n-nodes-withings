{
  "name": "@fjacquet/n8n-nodes-withings",
  "version": "2.0.0",
  "description": "n8n community node for the Withings Health API with native n8n OAuth2 (automatic token refresh)",
  "keywords": [
    "n8n-community-node-package",
    "withings",
    "health",
    "fitness",
    "oauth2"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fjacquet/n8n-nodes-withings",
  "author": {
    "name": "Frederic Jacquet",
    "email": "fred@ljf.ch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fjacquet/n8n-nodes-withings.git"
  },
  "bugs": {
    "url": "https://github.com/fjacquet/n8n-nodes-withings/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "biome check . && n8n-node lint",
    "lint:n8n": "n8n-node lint",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/WithingsOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WithingsApi/WithingsApi.node.js"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@n8n/node-cli": "^0.48.5",
    "eslint": "9.39.5",
    "n8n-workflow": "2.40.1",
    "release-it": "20.2.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
